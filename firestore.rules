rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users/{userId}/stages/{stage}/todos
//   Path:   userId = the signed-in user's Firebase Auth uid (owner)
//           stage  = one of 'local', 'dev', 'alpha', 'staging', 'main'
//                    (each app stage keeps its own list)
// Document ID: auto-generated by Firestore
// Fields:
//   - text:      string    (required, 1-500 chars, editable)  - the to-do text
//   - done:      bool      (required)                         - ticked off or not
//   - p:         string    (required, 'high'|'med'|'low'|'none') - priority
//   - pos:       number    (required, 0..1e13, immutable)     - sort order (ms time)
//   - createdAt: timestamp (required, = server time on create, immutable)
//   - doneAt:    number|null (optional) - when it was ticked (ms since 1970),
//                null/absent when not done or done before this existed
//   - starred:   bool (optional)             - starred: shown at the very top (Issue #22)
//   - due:       string|null (optional)      - due date 'YYYY-MM-DD' (Issue #23)
//   - time:      string|null (optional)      - scheduled time 'HH:MM', 24-hour (Issue #50)
//   - note:      string|null (optional)      - note, up to 2000 chars (Issue #57)
//   - archived:  bool (optional)             - archived (hidden, kept) done to-do (Issue #49)
//   - remind:    'off'|0|15|60|null (optional) - reminder minutes before its time; null = the device default (Issue #51)
//   - myDay:     string|null (optional)      - day it was added to My Day 'YYYY-MM-DD' (Issue #71)
//   - list:      string|null (optional)      - id of one of the user's own lists (Issue #72)
//   - evening:   bool (optional)             - "Tonight": due today, sorted after the day's others (Issue #43)
//   - items:     list (optional, up to 50)   - checklist [{ text, done }] (Issue #44; rules can't
//                                              check inside a list, so the app cleans each item)
//
// Collection: issueReports (Issue #28: "Report issue" on the stage banner)
// Document ID: auto-generated by Firestore
// Fields: title (1-120), body (1-5000), type ('bug'|'feature'|'tweak'|
//   'performance'|null), stage, uid (= reporter), email (= reporter's
//   verified sign-in email), status ('new'), createdAt (= server time),
//   screenshot (optional: JPEG data URL, at most ~750 KB, shrunk on the device).
// Only testers may add one: their email must be in access/testers.emails
// (edited in the Firebase console, never in the repo). Nobody can read,
// change or delete reports from the app; a GitHub Action (admin access)
// turns them into GitHub issues and emails the reporter (a receipt, then
// "it's fixed" when the fix reaches Production, Issue #34).
//
// Document: access/testers  { emails: [lower-case addresses] }
//   Not readable or writable from the app.
//
// The parent documents users/{userId} and .../stages/{stage} are never
// written; nothing else in the database is readable or writable.
// Users can create to-dos, tick them, change priority, edit the text and
// delete them (Issue #40).
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the signed-in user owns this path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Only these fields may change on update
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isValidStage(stage) {
      return stage in ['local', 'dev', 'alpha', 'staging', 'main'];
    }

    // ===============================================================
    // Domain Validators (used in both create and update)
    // ===============================================================

    function isValidTodo() {
      let data = request.resource.data;
      return hasRequiredFields(['text', 'done', 'p', 'pos', 'createdAt']) &&
        hasOnlyAllowedFields(['text', 'done', 'p', 'pos', 'createdAt', 'doneAt', 'starred', 'due', 'evening', 'time', 'items', 'archived', 'note', 'myDay', 'list', 'remind']) &&
        validStringLength('text', 1, 500) &&
        data.done is bool &&
        data.p in ['high', 'med', 'low', 'none'] &&
        data.pos is number && data.pos >= 0 && data.pos <= 10000000000000 &&
        data.createdAt is timestamp &&
        (!('doneAt' in data) || data.doneAt == null ||
          (data.doneAt is number && data.doneAt >= 0 && data.doneAt <= 10000000000000)) &&
        (!('starred' in data) || data.starred is bool) &&
        (!('evening' in data) || data.evening is bool) &&
        (!('archived' in data) || data.archived is bool) &&
        (!('list' in data) || data.list == null ||
          (data.list is string && data.list.matches('^[A-Za-z0-9_-]{1,40}$'))) &&   // own list (Issue #72)
        (!('myDay' in data) || data.myDay == null ||
          (data.myDay is string && data.myDay.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$'))) &&   // My Day (Issue #71)
        (!('remind' in data) || data.remind == null || data.remind == 'off' ||
          (data.remind is int && data.remind in [0, 15, 60])) &&   // reminder (Issue #51)
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 2000)) &&   // note (Issue #57)   // archived done to-do (Issue #49)
        (!('time' in data) || data.time == null ||
          (data.time is string && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))) &&   // scheduled time (Issue #50)   // "Tonight" (Issue #43)
        (!('items' in data) || (data.items is list && data.items.size() <= 50)) &&   // checklist (Issue #44)
        (!('due' in data) || data.due == null ||
          (data.due is string && data.due.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')));   // due date (Issue #23)   // starred to-dos sit at the top (Issue #22)
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Phone notifications (Issue #51, part 2): one record per device that turned them on.
    // The owner writes it (token, stage, default lead, time zone, the app's address);
    // the sendReminders Cloud Function reads it with admin access. Nothing else can.
    function isValidDevice() {
      let d = request.resource.data;
      return d.keys().hasAll(['token', 'stage', 'lead', 'tz', 'url', 'updatedAt']) &&
        d.keys().hasOnly(['token', 'stage', 'lead', 'tz', 'url', 'updatedAt']) &&
        d.token is string && d.token.size() > 0 && d.token.size() <= 4096 &&
        isValidStage(d.stage) &&
        d.lead in [0, 15, 60] &&
        d.tz is string && d.tz.size() > 0 && d.tz.size() <= 64 &&
        d.url is string && d.url.size() <= 300 && d.url.matches('^https?://[^ ]+$') &&
        d.updatedAt == request.time;
    }
    match /users/{userId}/devices/{deviceId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && deviceId.matches('^[A-Za-z0-9_-]{8,40}$') && isValidDevice();
    }

    match /users/{userId}/stages/{stage}/todos/{todoId} {
      // Owner only: read their own list (the app queries it ordered by pos).
      allow read: if isOwner(userId) && isValidStage(stage);

      // Owner only: add a valid to-do, stamped with the real server time.
      allow create: if isOwner(userId) && isValidStage(stage) &&
        isValidTodo() &&
        request.resource.data.createdAt == request.time;

      // Owner only: tick/untick (with the time it was ticked), change
      // priority, star/unstar, set a due date and edit the text (still 1-500 chars). Order and creation
      // time can't change, and the result must still be valid.
      allow update: if isOwner(userId) && isValidStage(stage) &&
        isValidTodo() &&
        onlyChanges(['done', 'p', 'doneAt', 'text', 'starred', 'due', 'evening', 'time', 'items', 'archived', 'note', 'myDay', 'list', 'remind']);

      // Owner only: delete one of their own to-dos (Issue #40).
      allow delete: if isOwner(userId) && isValidStage(stage);
    }

    // The user's own lists (Issue #72): users/{uid}/stages/{stage}/lists/{listId}
    //   - name:      string (required, 1-40 chars)
    //   - color:     one of the app's 12 colours (required)
    //   - icon:      one of the app's 16 list icons (required)
    //   - pos:       number (required, 0..1e13)  - order in the Lists panel
    //   - createdAt: timestamp (required, = server time on create, immutable)
    function isValidList() {
      let data = request.resource.data;
      return hasRequiredFields(['name', 'color', 'icon', 'pos', 'createdAt']) &&
        hasOnlyAllowedFields(['name', 'color', 'icon', 'pos', 'createdAt']) &&
        validStringLength('name', 1, 40) &&
        data.color in ['red', 'orange', 'yellow', 'lime', 'green', 'teal', 'cyan', 'blue', 'purple', 'grape', 'pink', 'graphite'] &&
        data.icon in ['list', 'house', 'briefcase', 'shopping-cart', 'heart', 'airplane', 'book-open', 'barbell',
          'gift', 'folder-simple', 'car', 'paw-print', 'fork-knife', 'wallet', 'wrench', 'graduation-cap'] &&
        data.pos is number && data.pos >= 0 && data.pos <= 10000000000000 &&
        data.createdAt is timestamp;
    }

    match /users/{userId}/stages/{stage}/lists/{listId} {
      allow read: if isOwner(userId) && isValidStage(stage);
      allow create: if isOwner(userId) && isValidStage(stage) && listId.matches('^[A-Za-z0-9_-]{1,40}$') &&
        isValidList() && request.resource.data.createdAt == request.time;
      // Rename, recolour, change icon or reorder; createdAt can't change.
      allow update: if isOwner(userId) && isValidStage(stage) && isValidList() && onlyChanges(['name', 'color', 'icon', 'pos']);
      allow delete: if isOwner(userId) && isValidStage(stage);
    }

    function isTester() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/access/testers) &&
        request.auth.token.email.lower() in get(/databases/$(database)/documents/access/testers).data.emails;
    }

    match /issueReports/{reportId} {
      // Testers only: add one new report, stamped with their own account and
      // the server time. No reading back, editing or deleting from the app.
      allow create: if isTester() &&
        hasRequiredFields(['title', 'body', 'type', 'stage', 'uid', 'email', 'status', 'createdAt']) &&
        hasOnlyAllowedFields(['title', 'body', 'type', 'stage', 'uid', 'email', 'status', 'createdAt', 'screenshot']) &&
        (!('screenshot' in request.resource.data) ||
          (request.resource.data.screenshot is string &&
           request.resource.data.screenshot.size() <= 750000 &&
           request.resource.data.screenshot.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$'))) &&   // optional screenshot
        validStringLength('title', 1, 120) &&
        validStringLength('body', 1, 5000) &&
        (request.resource.data.type == null ||
          request.resource.data.type in ['bug', 'feature', 'tweak', 'performance']) &&
        isValidStage(request.resource.data.stage) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time;
    }

    // Everything else is denied by default.
  }
}
