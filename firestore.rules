rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file assumes the following data structures:
//
// Collection: users/{userId}/stages/{stage}/todos
//   Path:   userId = the signed-in user's Firebase Auth uid (owner)
//           stage  = one of 'local', 'dev', 'alpha', 'staging', 'main'
//                    (each app stage keeps its own list)
// Document ID: auto-generated by Firestore
// Fields:
//   - text:      string    (required, 1-500 chars, immutable) - the to-do text
//   - done:      bool      (required)                         - ticked off or not
//   - p:         string    (required, 'high'|'med'|'low'|'none') - priority
//   - pos:       number    (required, 0..1e13, immutable)     - sort order (ms time)
//   - createdAt: timestamp (required, = server time on create, immutable)
//
// The parent documents users/{userId} and .../stages/{stage} are never
// written; nothing else in the database is readable or writable.
// Users can create to-dos, tick them and change priority. There is no
// delete in the app yet, so deletes are not allowed.
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the signed-in user owns this path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Only these fields may change on update
    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isValidStage(stage) {
      return stage in ['local', 'dev', 'alpha', 'staging', 'main'];
    }

    // ===============================================================
    // Domain Validators (used in both create and update)
    // ===============================================================

    function isValidTodo() {
      let data = request.resource.data;
      return hasRequiredFields(['text', 'done', 'p', 'pos', 'createdAt']) &&
        hasOnlyAllowedFields(['text', 'done', 'p', 'pos', 'createdAt']) &&
        validStringLength('text', 1, 500) &&
        data.done is bool &&
        data.p in ['high', 'med', 'low', 'none'] &&
        data.pos is number && data.pos >= 0 && data.pos <= 10000000000000 &&
        data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId}/stages/{stage}/todos/{todoId} {
      // Owner only: read their own list (the app queries it ordered by pos).
      allow read: if isOwner(userId) && isValidStage(stage);

      // Owner only: add a valid to-do, stamped with the real server time.
      allow create: if isOwner(userId) && isValidStage(stage) &&
        isValidTodo() &&
        request.resource.data.createdAt == request.time;

      // Owner only: tick/untick and change priority. Text, order and
      // creation time can't change, and the result must still be valid.
      allow update: if isOwner(userId) && isValidStage(stage) &&
        isValidTodo() &&
        onlyChanges(['done', 'p']);

      // No deletes (the app has no delete feature yet).
    }

    // Everything else is denied by default.
  }
}
